# .env のテンプレート。このファイルをコピーして .env を作成し、各値を設定してください。
#
#   cp .env.example .env
#
# .env は .gitignore 済みです（このテンプレートのみコミット対象）。

# ===== Django =====
# 必須。デフォルト値を持たないため、未設定だと起動時に UndefinedValueError で失敗します。
# 生成例:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# 本番は False。省略時も False（fail-safe）。ローカル開発では True にします。
DEBUG=True

# カンマ区切り。省略時は localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# ===== データベース（PostgreSQL）=====
# 省略時は下記のデフォルト値が使われます。
DB_NAME=portfolio_db
DB_USER=portf_admin
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ===== ログイン試行のロック（省略可。既定値は settings.py 参照）=====
# 連続失敗でのロック閾値と秒数。ID/PWログインと商談用アクセスの両方に適用されます。
#   LOGIN_LOCK_THRESHOLD=5
#   LOGIN_LOCK_SECONDS=60
#   LOGIN_LOCK_MAX_SECONDS=3600
#   LOGIN_LOCK_SCOPE=user_ip

# ===== 商談用アクセス（省略可。既定値は settings.py 参照）=====
#   MEETING_REVOKE_THRESHOLD=20
#   MEETING_EXPIRE_DAYS=30
#   MEETING_IDLE_DAYS=7
#   MEETING_TOKEN_LENGTH=15
#   MEETING_PASSWORD_LENGTH=16

# ===== work_shift アプリのみで使用 =====
# FastAPI製の読み取り専任BFF（別プロセス）が参照するDB接続URL。
# 上記の DB_* と同じデータベースを指すこと。
# uvicorn 起動時に環境変数として渡す運用のため、.env に置く場合は読み込み方法に注意。
#   WSFT_DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/<dbname>

# ===== 参考: 現在 settings.py から参照されていないキー =====
# メール送信は console バックエンド固定のため、以下は未使用です。
# SMTP送信へ切り替える際に settings.py 側の実装とあわせて有効化してください。
#   EMAIL_HOST=
#   EMAIL_PORT=
#   EMAIL_HOST_USER=
#   EMAIL_HOST_PASSWORD=
#   EMAIL_USE_TLS=
